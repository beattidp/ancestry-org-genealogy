# FamilySearch Configuration Template
# Copy this file to .env:
#   cp .env.example .env
#
# Then fill in your active session token below.

# HOW TO GET YOUR fssessionid:
# 1. Open your browser and log into https://www.familysearch.org (via normal login, SSO, or 2FA).
# 2. Open Developer Tools (F12 or Ctrl+Shift+I / Cmd+Option+I).
# 3. Go to the "Application" tab (Chrome/Edge) or "Storage" tab (Firefox).
# 4. Under "Cookies" in the left sidebar, click "https://www.familysearch.org".
# 5. Find the cookie named "fssessionid" and copy its entire Value string.
# 6. Paste it below as FAMILYSEARCH_SESSION_ID.
FAMILYSEARCH_SESSION_ID=""

# API Environment: "production" (default) or "beta"
FAMILYSEARCH_ENV="production"

# Optional: Developer App Key (Client ID) if using official OAuth2 developer credentials
FAMILYSEARCH_APP_KEY=""
